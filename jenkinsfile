pipeline {
    agent any

    environment {
        // Tomcat path configuration
        TOMCAT_PATH = "C:\\Program Files\\Apache Software Foundation\\Tomcat 10.1\\webapps"
        FRONTEND_FOLDER = "Frontend"
        BACKEND_FOLDER = "Backend2"
    }

    stages {

        // ===== FRONTEND BUILD =====
        stage('Build Frontend') {
            steps {
                dir("${FRONTEND_FOLDER}") {
                    bat 'npm install'
                    bat 'npm run build'
                }
            }
        }

        // ===== FRONTEND DEPLOY =====
        stage('Deploy Frontend to Tomcat') {
            steps {
                bat """
                if exist "${TOMCAT_PATH}\\reactf1playerapi" (
                    rmdir /S /Q "${TOMCAT_PATH}\\reactf1playerapi"
                )
                mkdir "${TOMCAT_PATH}\\reactf1playerapi"
                xcopy /E /I /Y "${WORKSPACE}\\${FRONTEND_FOLDER}\\dist\\*" "${TOMCAT_PATH}\\reactf1playerapi\\"
                """
            }
        }

        // ===== BACKEND BUILD =====
        stage('Build Backend') {
            steps {
                dir("${BACKEND_FOLDER}") {
                    bat 'mvn clean package -DskipTests'
                }
            }
        }

        // ===== BACKEND DEPLOY =====
        stage('Deploy Backend to Tomcat') {
            steps {
                bat """
                if exist "${TOMCAT_PATH}\\Springbootf1project.war" (
                    del /Q "${TOMCAT_PATH}\\Springbootf1project.war"
                )
                if exist "${TOMCAT_PATH}\\Springbootf1project" (
                    rmdir /S /Q "${TOMCAT_PATH}\\Springbootf1project"
                )
                copy "${WORKSPACE}\\${BACKEND_FOLDER}\\target\\*.war" "${TOMCAT_PATH}\\Springbootf1project.war"
                """
            }
        }
    }

    post {
        success {
            echo '✅ Deployment Successful!'
        }
        failure {
            echo '❌ Pipeline Failed. Please check logs.'
        }
    }
}